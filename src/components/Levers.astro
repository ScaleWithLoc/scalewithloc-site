---
import { levers } from '../data/content';
---

<section id="levers" class="section border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40" aria-labelledby="levers-title">
  <div class="container-page">
    <p class="eyebrow">{levers.eyebrow}</p>
    <h2 id="levers-title" class="section-title">{levers.title}</h2>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        levers.items.map((lever) => (
          <li class="card">
            <span class="block text-5xl font-extrabold tracking-tight text-accent dark:text-accent-dark" aria-hidden="true">
              {lever.number}
            </span>
            <h3 class="mt-6 text-xl font-bold">
              <span class="sr-only">{lever.number} / </span>
              {lever.title}
            </h3>
            <p class="mt-3 leading-relaxed text-muted">{lever.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
