---
import { contact, links } from '../data/content';

const items = [
  links.email && { label: 'Email', value: links.email, href: `mailto:${links.email}` },
  { label: 'LinkedIn', value: 'in/loc-lam', href: links.linkedin, external: true },
  { label: 'YouTube', value: links.youtubeHandle, href: links.youtube, external: true },
].filter(Boolean) as { label: string; value: string; href: string; external?: boolean }[];
---

<section id="contact" class="bg-slate-950 py-20 text-white sm:py-28" aria-labelledby="contact-title">
  <div class="container-page">
    <h2 id="contact-title" class="max-w-3xl text-4xl font-extrabold tracking-tight text-balance sm:text-6xl">
      {contact.title}
    </h2>

    <ul class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-2xl border border-slate-800 p-6 transition-colors hover:border-accent-dark"
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="block text-sm text-slate-400">{item.label}</span>
              <span class="mt-1 block text-lg font-semibold break-all">
                {item.value}
                {item.external && <span class="sr-only"> (opens in a new tab)</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-lg text-slate-400">{contact.resumeNote}</p>
  </div>
</section>
