---
import { teaching } from '../data/content';
---

<section id="teaching" class="section border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40" aria-labelledby="teaching-title">
  <div class="container-page">
    <p class="eyebrow">{teaching.eyebrow}</p>
    <h2 id="teaching-title" class="section-title">{teaching.title}</h2>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        teaching.items.map((item) => {
          const external = item.href.startsWith('http');
          const inner = (
            <>
              <h3 class="text-lg font-bold leading-snug">{item.title}</h3>
              {item.body && <p class="mt-2 text-muted">{item.body}</p>}
            </>
          );
          return (
            <li class="flex">
              {item.href ? (
                <a
                  href={item.href}
                  class="card group flex w-full flex-col p-6! transition-colors hover:border-accent dark:hover:border-accent-dark"
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {inner}
                  <span class="mt-auto pt-5 text-sm font-semibold text-accent dark:text-accent-dark">
                    Visit <span aria-hidden="true">↗</span>
                    {external && <span class="sr-only"> (opens in a new tab)</span>}
                  </span>
                </a>
              ) : (
                <div class="card flex w-full flex-col p-6!">{inner}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
