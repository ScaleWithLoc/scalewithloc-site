---
import { featuredBuild as fb } from '../data/content';
import Tags from './Tags.astro';

// Accepts youtube.com/watch?v=, youtu.be/, /embed/ and /shorts/ links.
function youtubeId(url: string): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtu.be')) return u.pathname.slice(1) || null;
    if (u.searchParams.get('v')) return u.searchParams.get('v');
    const m = u.pathname.match(/\/(embed|shorts|live)\/([^/?]+)/);
    return m ? m[2] : null;
  } catch {
    return null;
  }
}
const videoId = youtubeId(fb.videoUrl);
---

<section id="build" class="section border-y border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40" aria-labelledby="build-title">
  <div class="container-page">
    <p class="eyebrow">{fb.eyebrow}</p>
    <h2 id="build-title" class="section-title">{fb.title}</h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-14">
      <dl class="space-y-7">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Problem</dt>
          <dd class="mt-2 text-lg leading-relaxed">{fb.problem}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
            What I built <span class="normal-case tracking-normal">({fb.builtWith})</span>
          </dt>
          <dd class="mt-2 text-lg leading-relaxed">{fb.whatIBuilt}</dd>
        </div>
      </dl>
      <dl class="space-y-7">
        <div class="card">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-accent dark:text-accent-dark">Result</dt>
          <dd class="mt-2 text-xl font-semibold leading-snug">{fb.result}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">What I'd do next</dt>
          <dd class="mt-2 text-lg leading-relaxed">{fb.next}</dd>
        </div>
      </dl>
    </div>

    <!-- Flow diagram -->
    <ol class="mt-14 flex flex-col items-stretch gap-3 md:flex-row md:items-center" aria-label="Workflow steps">
      {
        fb.flow.map((s, i) => (
          <>
            <li class="flex-1 rounded-2xl border-2 border-accent/25 bg-white p-5 text-center dark:border-accent-dark/30 dark:bg-slate-900">
              <span class="block text-xs font-semibold text-accent dark:text-accent-dark">Step {i + 1}</span>
              <span class="mt-1 block text-lg font-bold">{s.step}</span>
              <span class="mt-1 block text-sm text-muted">{s.detail}</span>
            </li>
            {i < fb.flow.length - 1 && (
              <li aria-hidden="true" class="flex justify-center text-2xl font-bold text-accent dark:text-accent-dark">
                <span class="rotate-90 md:rotate-0">→</span>
              </li>
            )}
          </>
        ))
      }
    </ol>

    <!-- Screenshot (click to enlarge) -->
    <figure class="mt-10">
      <button
        type="button"
        id="shot-open"
        class="group block w-full overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800"
        aria-label="Enlarge n8n workflow screenshot"
      >
        <img
          src={fb.screenshot.src}
          alt={fb.screenshot.alt}
          width="1600"
          height="831"
          loading="lazy"
          class="w-full transition-transform duration-300 group-hover:scale-[1.01]"
        />
      </button>
      <figcaption class="mt-3 text-sm text-muted">{fb.screenshot.caption}</figcaption>
    </figure>

    <dialog
      id="shot-dialog"
      class="m-auto max-h-[95vh] max-w-[95vw] rounded-xl bg-white p-0 backdrop:bg-slate-950/80 dark:bg-slate-900"
      aria-label="n8n workflow screenshot, enlarged"
    >
      <form method="dialog" class="flex justify-end p-2">
        <button class="btn btn-secondary px-4! py-1.5! text-sm!" autofocus>Close</button>
      </form>
      <img src={fb.screenshot.fullSrc} alt={fb.screenshot.alt} width="2452" height="1274" loading="lazy" class="block h-auto max-h-[85vh] w-auto" />
    </dialog>

    {
      videoId && (
        <div class="mt-10">
          <h3 class="text-xl font-bold">Demo video</h3>
          <div class="mt-4 aspect-video overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
            <iframe
              class="size-full"
              src={`https://www.youtube-nocookie.com/embed/${videoId}`}
              title={`${fb.title} demo video`}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>
      )
    }

    <Tags tags={fb.tags} class="mt-10" />
  </div>
</section>

<script>
  const dialog = document.getElementById('shot-dialog') as HTMLDialogElement;
  document.getElementById('shot-open')!.addEventListener('click', () => dialog.showModal());
  // Close when clicking the dimmed backdrop
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
